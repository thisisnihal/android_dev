<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:gravity="center">

    <!-- ImageView to display the selected image -->
    <ImageView
        android:id="@+id/imageView"
        android:layout_width="200dp"
        android:layout_height="200dp"
        android:contentDescription="Selected Image"
        android:layout_marginBottom="20dp"
        android:src="@android:drawable/ic_menu_gallery" /> <!-- Default image -->

    <!-- Button to select an image -->
    <Button
        android:id="@+id/selectImageButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Select Image" />

    <!-- Button to convert the selected image to PDF -->
    <Button
        android:id="@+id/convertToPdfButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Convert to PDF"
        android:layout_marginTop="20dp"
        android:enabled="false" /> <!-- Initially disabled -->

</LinearLayout>
